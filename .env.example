# ── Desenvolvimento local (Docker) ──────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financeiro
DB_USER=postgres
DB_PASSWORD=postgres

# ── Produção (Neon / Supabase / Railway) ────────────
# Descomente e preencha para rodar o migrate.js contra o banco remoto:
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# ── Autenticação JWT ────────────────────────────────
# Gere uma string aleatória forte (ex: openssl rand -hex 32)
JWT_SECRET=troque-por-uma-chave-secreta-forte
